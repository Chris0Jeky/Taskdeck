{
  "name": "taskdeck-capture",
  "displayName": "Taskdeck Capture",
  "description": "Capture selected text and IDE context to Taskdeck inbox",
  "version": "0.1.0",
  "publisher": "taskdeck",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "taskdeck.captureSelection",
        "title": "Taskdeck: Capture Selection"
      },
      {
        "command": "taskdeck.captureFile",
        "title": "Taskdeck: Capture Current File Context"
      },
      {
        "command": "taskdeck.setApiUrl",
        "title": "Taskdeck: Set API URL"
      },
      {
        "command": "taskdeck.setToken",
        "title": "Taskdeck: Set Authentication Token"
      }
    ],
    "keybindings": [
      {
        "command": "taskdeck.captureSelection",
        "key": "ctrl+shift+alt+t",
        "mac": "cmd+shift+alt+t",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Taskdeck",
      "properties": {
        "taskdeck.apiUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "Taskdeck API base URL"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "taskdeck.captureSelection",
          "when": "editorHasSelection",
          "group": "taskdeck"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npx tsc -p ./ && node ./out/context.test.js && node ./out/apiUrl.test.js && node ./out/manifest.test.js && node ./out/statusReset.test.js && node ./out/pathMatch.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
