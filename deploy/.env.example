TASKDECK_PROXY_PORT=8080
TASKDECK_VITE_API_BASE_URL=/api

# Required. Must be a strong, unpredictable value (minimum 32 bytes).
# Generate with: openssl rand -base64 48
# See docs/security/SECRETS_MANAGEMENT_BASELINE.md for rotation procedures.
TASKDECK_JWT_SECRET=
TASKDECK_JWT_ISSUER=Taskdeck
TASKDECK_JWT_AUDIENCE=TaskdeckUsers
TASKDECK_JWT_EXPIRATION_MINUTES=1440

# Optional. Only needed when using live LLM providers (Mock is default).
# See docs/platform/LLM_PROVIDER_SETUP_GUIDE.md for provider setup.
# TASKDECK_LLM_ENABLE_LIVE_PROVIDERS=false
# TASKDECK_LLM_PROVIDER=Mock
# TASKDECK_LLM_OPENAI_API_KEY=
# TASKDECK_LLM_GEMINI_API_KEY=
