# =============================================================================
# Taskdeck Cloud Production Environment Variables
# =============================================================================
# Copy this file and set values for your cloud deployment.
# DO NOT commit the filled-in copy to version control.
#
# On Railway: set these in the Variables tab of your service.
# On Render:  set these in the Environment section of your service.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Authentication
# ---------------------------------------------------------------------------

# JWT signing secret. MUST be a strong, unpredictable value (minimum 32 bytes).
# Generate with: openssl rand -base64 48
# NEVER use the placeholder below in production.
Jwt__SecretKey=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48

# JWT token settings (defaults are sensible for most deployments)
Jwt__Issuer=Taskdeck
Jwt__Audience=TaskdeckUsers
Jwt__ExpirationMinutes=1440

# ---------------------------------------------------------------------------
# REQUIRED — CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
# Must include the full URL where users access Taskdeck.
# Examples:
#   Railway:  https://taskdeck-production.up.railway.app
#   Render:   https://taskdeck.onrender.com
#   Custom:   https://taskdeck.yourdomain.com
Cors__AllowedOrigins=https://your-taskdeck-url.example.com

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# SQLite database path. Point to persistent volume so data survives deploys.
# Railway: attach a volume at /app/data
# Render:  disk is configured in render.yaml at /app/data
ConnectionStrings__DefaultConnection=Data Source=/app/data/taskdeck.db

# ---------------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Disable browser auto-open (meaningless in containers)
FirstRun__AutoOpenBrowser=false
# Disable AppData path resolution (use explicit path above)
FirstRun__ResolveAppDataDbPath=false

# Disable development sandbox in production
DevelopmentSandbox__Enabled=false

# ---------------------------------------------------------------------------
# OPTIONAL — LLM Providers
# ---------------------------------------------------------------------------

# Mock provider is the default (no external API calls).
# Set EnableLiveProviders=true and Provider to OpenAI or Gemini for live AI.
Llm__EnableLiveProviders=false
Llm__Provider=Mock
# Llm__OpenAi__ApiKey=sk-...
# Llm__Gemini__ApiKey=AI...

# ---------------------------------------------------------------------------
# OPTIONAL — GitHub OAuth (external login)
# ---------------------------------------------------------------------------

# GitHubOAuth__ClientId=
# GitHubOAuth__ClientSecret=

# ---------------------------------------------------------------------------
# OPTIONAL — SignalR Redis Backplane (for multi-instance scaling)
# ---------------------------------------------------------------------------

# Not needed for single-instance SQLite deployments.
# Required when scaling to multiple instances behind a load balancer.
# SignalR__Redis__ConnectionString=redis://user:password@host:6379

# ---------------------------------------------------------------------------
# OPTIONAL — Observability
# ---------------------------------------------------------------------------

# OpenTelemetry is enabled by default. Set an OTLP endpoint to export metrics.
# Observability__OtlpEndpoint=https://otel-collector.example.com:4317
# Observability__EnableConsoleExporter=false

# ---------------------------------------------------------------------------
# OPTIONAL — Sentry Error Tracking
# ---------------------------------------------------------------------------

# Sentry__Enabled=false
# Sentry__Dsn=https://examplekey@sentry.io/12345
# Sentry__TracesSampleRate=0.1

# ---------------------------------------------------------------------------
# OPTIONAL — Forwarded Headers (proxy trust)
# ---------------------------------------------------------------------------

# Railway and Render handle TLS termination. The app trusts X-Forwarded-*
# headers when ASPNETCORE_FORWARDEDHEADERS_ENABLED=true.
# For custom proxy setups, you may need to configure:
# ForwardedHeaders__KnownProxies=10.0.0.1
# ForwardedHeaders__KnownNetworks=10.0.0.0/8
# ForwardedHeaders__ForwardLimit=1
