aws_region         = "eu-west-2"
availability_zone  = "eu-west-2b"
vpc_cidr           = "10.60.0.0/16"
public_subnet_cidr = "10.60.1.0/24"
ami_id             = "ami-xxxxxxxxxxxxxxxxx" # Ubuntu 24.04 LTS for your region
instance_type      = "t3.large"
ssh_key_name       = "taskdeck-prod"

allowed_ingress_cidrs = [
  "203.0.113.0/24",
]

api_image  = "ghcr.io/example/taskdeck-api:prod-latest"
web_image  = "ghcr.io/example/taskdeck-web:prod-latest"
jwt_secret_ssm_parameter_name = "/taskdeck/prod/jwt-secret"
# jwt_secret_kms_key_arn      = "arn:aws:kms:eu-west-2:123456789012:key/replace-with-your-key"

extra_tags = {
  Owner   = "platform"
  Purpose = "taskdeck-prod"
}
