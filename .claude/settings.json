      "Bash(bash scripts/worktree_guard.sh:*)",
      "Bash(powershell -File scripts/git/New-CodexIssueWorktree.ps1:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet --version:*)",
      "Bash(dotnet clean:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet tool install:*)",
      "Bash(dotnet tool uninstall:*)",
      "Bash(dotnet nuget:*)",
      "Bash(dotnet ef migrations:*)",
      "Bash(dotnet ef database:*)",
      "Bash(dotnet format:*)",
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(npx eslint:*)",
      "PowerShell(py -3 -B scripts/agent_hooks/render_failure_ledger.py:*)",
