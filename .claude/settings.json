{
  "includeCoAuthoredBy": false,
  "enableAllProjectMcpServers": true,
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "worktree": {
    "symlinkDirectories": ["node_modules", "frontend/taskdeck-web/node_modules"]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(powershell -File scripts/worktree_guard.ps1:*)",
      "Bash(source scripts/worktree_guard.sh:*)",
      "Bash(bash scripts/worktree_guard.sh:*)",
      "Bash(powershell -File scripts/git/New-CodexIssueWorktree.ps1:*)",
      "PowerShell(powershell -File scripts/worktree_guard.ps1:*)",
      "PowerShell(powershell -File scripts/git/New-CodexIssueWorktree.ps1:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet --version:*)",
      "Bash(dotnet clean:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet tool install:*)",
      "Bash(dotnet tool uninstall:*)",
      "Bash(dotnet nuget:*)",
      "Bash(dotnet ef migrations:*)",
      "Bash(dotnet ef database:*)",
      "Bash(dotnet format:*)",
      "Bash(node --version:*)",
      "Bash(npm --version:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(python scripts/agent_hooks/pre_tool_use.py:*)",
      "Bash(python scripts/agent_hooks/post_tool_use.py:*)",
      "Bash(python scripts/agent_hooks/post_tool_failure.py:*)",
      "Bash(python scripts/agent_hooks/render_failure_ledger.py:*)",
      "Bash(python scripts/agent_hooks/smoke_test.py:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git push:*)",
      "Bash(gh :*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker ps:*)",
      "Bash(docker :*)",
      "Bash(taskkill:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git clean -fd:*)",
      "Bash(git checkout --:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf *:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "python \"$env:CLAUDE_PROJECT_DIR\\scripts\\agent_hooks\\pre_tool_use.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\pre-commit.ps1\"",
            "timeout": 120,
            "statusMessage": "Running pre-commit checks..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "python \"$env:CLAUDE_PROJECT_DIR\\scripts\\agent_hooks\\post_tool_use.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "shell": "powershell",
            "command": "python \"$env:CLAUDE_PROJECT_DIR\\scripts\\agent_hooks\\post_tool_use.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "python \"$env:CLAUDE_PROJECT_DIR\\scripts\\agent_hooks\\post_tool_failure.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "Write-Output 'Taskdeck repo. Read CLAUDE.md for context. Read docs/STATUS.md for current state before making changes. Check OUTSTANDING_TASKS.md and surface its open items in summaries.'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
