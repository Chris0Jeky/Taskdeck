{
  "name": "taskdeck-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "dev": "node ./scripts/run-vite-dev.mjs",
    "demo:reset-db": "node ./scripts/demo-reset-db.mjs",
    "demo:seed": "node ./scripts/demo-seed.mjs",
    "demo:run": "node ./scripts/demo-run.mjs",
    "demo:autopilot": "node ./scripts/demo-autopilot.mjs",
    "demo:snapshot": "node ./scripts/demo-snapshot.mjs --out ./demo-artifacts/snapshot.json",
    "demo:director": "node ./scripts/demo-director.mjs",
    "demo:director:smoke": "node ./scripts/demo-director.mjs --output-dir ./demo-artifacts/ci-smoke --e2e-db ./taskdeck.demo.ci.db --reset-e2e-db --scenario engineering-sprint --skip-llm --turns 0 --rng-seed ci-smoke",
    "lint": "eslint . --max-warnings=20",
    "typecheck": "vue-tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\" && vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=./test-results/vitest.coverage.junit.xml",
    "test:e2e": "playwright test",
    "test:e2e:audit:headed": "node -e \"process.env.TASKDECK_RUN_AUDIT='1';require('child_process').execSync('npx playwright test tests/e2e/manual-audit.spec.ts --headed --reporter=line',{stdio:'inherit',env:process.env})\"",
    "test:e2e:concurrency": "playwright test tests/e2e/concurrency.spec.ts --reporter=line",
    "test:e2e:live-llm:headed": "playwright test tests/e2e/live-llm.spec.ts --headed --reporter=line",
    "test:e2e:headed": "playwright test --headed",
    "mutation:test": "npx stryker run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:docs": "storybook build --docs -o storybook-docs",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@tanstack/vue-virtual": "^3.13.28",
    "axios": "^1.18.0",
    "dompurify": "^3.4.10",
    "marked": "^18.0.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@storybook/vue3-vite": "^10.4.5",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.2",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "axios-mock-adapter": "^2.1.0",
    "baseline-browser-mapping": "^2.10.37",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.3",
    "postcss": "^8.5.15",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
