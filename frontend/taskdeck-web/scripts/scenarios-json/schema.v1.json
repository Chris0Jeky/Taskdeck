{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taskdeck JSON Scenario v1",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "steps"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "createBoard",
            "applyStarterPack",
            "createCard",
            "updateCard",
            "moveCard",
            "addComment",
            "queueInstruction",
            "createCapture",
            "ignoreCapture",
            "cancelCapture",
            "triageCapture",
            "waitForCaptureProposal",
            "waitForCaptureOutcome",
            "executeProposal",
            "runOps"
          ]
        },
        "label": {
          "type": "string"
        },
        "alias": {
          "type": "string"
        },
        "requiresLlm": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
