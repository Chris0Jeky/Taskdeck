{
  "schema_version": 1,
  "rules": [
    "One active owner per hard-collision group.",
    "Vertical agents may propose fragments but do not edit a locked shared file.",
    "Generated files are updated only by the integration owner after rebasing all source changes.",
    "A claim expires only through coordinator release or an explicit stale-claim ruling."
  ],
  "hard_collision_groups": [
    {
      "id": "ef-integration-train",
      "patterns": [
        "backend/src/**/TaskdeckDbContext.cs",
        "backend/src/**/Migrations/**",
        "backend/src/**/*ModelSnapshot.cs",
        "backend/src/**/Persistence/Configurations/**"
      ],
      "owner_role": "database-integration-owner",
      "issues": [
        2255,
        2257,
        2260,
        2261,
        2276,
        2087,
        2092,
        2093,
        2094,
        2089
      ]
    },
    {
      "id": "work-model-contract",
      "patterns": [
        "backend/src/Taskdeck.Domain/Entities/Card.cs",
        "backend/src/**/Card*Dto*.cs",
        "backend/src/**/Proposal*Operation*.cs",
        "backend/src/**/Export*Manifest*.cs"
      ],
      "owner_role": "work-model-contract-owner",
      "issues": [
        2087,
        2092,
        2093,
        2094,
        2240
      ]
    },
    {
      "id": "context-fabric-intake",
      "patterns": [
        "backend/src/**/CaptureIntakeService.cs",
        "backend/src/Taskdeck.Domain/Entities/Capture.cs",
        "backend/src/Taskdeck.Domain/Entities/SourceAsset.cs"
      ],
      "owner_role": "capture-contract-owner",
      "issues": [
        2255,
        2256,
        2089
      ]
    },
    {
      "id": "processor-protocol-contract",
      "patterns": [
        "backend/src/Taskdeck.Application/Processing/Protocol/**",
        "docs/architecture/WORKER_PROTOCOL_V1.md"
      ],
      "owner_role": "processor-protocol-owner",
      "issues": [
        2257,
        2258,
        1429,
        2259
      ]
    },
    {
      "id": "application-registration-startup",
      "patterns": [
        "backend/src/**/ApplicationServiceRegistration.cs",
        "backend/src/**/Program.cs",
        "backend/src/**/DependencyInjection*.cs"
      ],
      "owner_role": "integration-owner",
      "issues": "all backend verticals"
    },
    {
      "id": "smart-ci-policy-receipt",
      "patterns": [
        "ci/schemas/**",
        "scripts/ci/smart-ci/**",
        ".github/workflows/**",
        "docs/STATUS.md"
      ],
      "owner_role": "smart-ci-contract-owner",
      "issues": [
        2330,
        2334,
        2336,
        2339,
        2324
      ]
    },
    {
      "id": "generated-architecture-status",
      "patterns": [
        "docs/architecture/DATA_MODEL.md",
        "autodoc/AGENT_INDEX.md",
        "docs/STATUS.md",
        "docs/generated/**"
      ],
      "owner_role": "docs-integration-owner",
      "issues": "many"
    }
  ],
  "low_collision_lanes": [
    {
      "issue": 2241,
      "patterns": [
        "new pure SSE parser/decoder files and focused tests"
      ]
    },
    {
      "issue": 2236,
      "patterns": [
        "scripts/analysis/**",
        "docs/analysis/refactoring/**"
      ]
    },
    {
      "issue": 2237,
      "patterns": [
        "benchmarks/**",
        "scripts/performance/**"
      ]
    },
    {
      "issue": 1308,
      "patterns": [
        "new telemetry contract/no-op/payload tests before startup wiring"
      ]
    },
    {
      "issue": 1310,
      "patterns": [
        "docs/product/launch/** and synthetic assets"
      ]
    }
  ]
}
