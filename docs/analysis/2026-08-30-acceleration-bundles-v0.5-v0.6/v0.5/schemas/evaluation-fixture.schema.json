{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskdeck.dev/schemas/evaluation-fixture.v1.json",
  "type": "object",
  "required": [
    "id",
    "capability",
    "sourceHash",
    "expectedKeys",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedKeys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
