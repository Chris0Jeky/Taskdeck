{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskdeck.processing-policy-snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "profileId",
    "profileVersion",
    "policyDigest",
    "createdAt",
    "policy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "profileId": {
      "type": "string",
      "format": "uuid"
    },
    "profileVersion": {
      "type": "integer",
      "minimum": 1
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "policy": {
      "$ref": "processing-profile.schema.json"
    }
  }
}
