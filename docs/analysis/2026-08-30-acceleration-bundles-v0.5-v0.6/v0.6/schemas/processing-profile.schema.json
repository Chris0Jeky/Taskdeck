{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskdeck.processing-profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "preset",
    "egressClass",
    "preferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "preset": {
      "enum": [
        "private",
        "balanced",
        "strict",
        "expert"
      ]
    },
    "egressClass": {
      "enum": [
        "local-only",
        "approved-destinations",
        "any-configured"
      ]
    },
    "approvedProcessorIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approvedHosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "hostname"
      }
    },
    "approvedRegions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedDataClasses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "text",
          "audio",
          "image",
          "document",
          "metadata"
        ]
      }
    },
    "perCaptureCostCeiling": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "deadlineMilliseconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "allowGpu": {
      "type": "boolean"
    },
    "allowDiarisation": {
      "type": "boolean"
    },
    "allowAlignment": {
      "type": "boolean"
    },
    "allowOcrEscalation": {
      "type": "boolean"
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "orderedProcessorIds"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z]+(?:[.-][a-z]+)+$"
          },
          "orderedProcessorIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
