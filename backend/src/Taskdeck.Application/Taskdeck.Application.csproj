<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Taskdeck.Api" />
    <InternalsVisibleTo Include="Taskdeck.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taskdeck.Domain\Taskdeck.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published processor-manifest contract and its canonical example travel with the assembly
         so tests and tooling read the shipped bytes, never a copy (ADR-0065 / CF-04). -->
    <EmbeddedResource Include="Processing\Schemas\processor-manifest.v1.schema.json" LogicalName="Taskdeck.Application.Processing.Schemas.processor-manifest.v1.schema.json" />
    <EmbeddedResource Include="Processing\Schemas\whisperx-processor.example.json" LogicalName="Taskdeck.Application.Processing.Schemas.whisperx-processor.example.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
