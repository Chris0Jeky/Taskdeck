{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Workers": {
    "QueuePollIntervalSeconds": 5,
    "MaxBatchSize": 5,
    "MaxConcurrency": 2,
    "MaxRetries": 3,
    "RetryBackoffSeconds": [10, 30, 90],
    "ProposalExpiryMinutes": 1440,
    "EnableAutoQueueProcessing": true
  },
  "Llm": {
    "EnableLiveProviders": false,
    "AllowLiveProvidersInDevelopment": false,
    "Provider": "Mock",
    "OpenAi": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4o-mini",
      "TimeoutSeconds": 30
    },
    "Gemini": {
      "ApiKey": "",
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "Model": "gemini-2.5-flash",
      "TimeoutSeconds": 30
    }
  },
  "Observability": {
    "EnableOpenTelemetry": true,
    "ServiceName": "Taskdeck.Api",
    "OtlpEndpoint": "",
    "EnableConsoleExporter": false,
    "MetricExportIntervalSeconds": 30
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPerIp": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "HotPathPerUser": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "CaptureWritePerUser": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "SecurityHeaders": {
    "Enabled": true,
    "EnableContentSecurityPolicy": true,
    "EnableXFrameOptions": true,
    "EnableXContentTypeOptions": true,
    "EnableReferrerPolicy": true,
    "EnableHsts": true,
    "ExcludeSwaggerFromContentSecurityPolicy": true,
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": false,
    "HstsPreload": false,
    "ContentSecurityPolicy": "default-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
    "XFrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=taskdeck.db"
  }
}
