{
  "Auth": {
    "Registration": {
      "Mode": "Open"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AuditRetention": {
    "MaxRetentionDays": 90,
    "CleanupBatchSize": 1000,
    "CleanupIntervalHours": 24
  },
  "Artefacts": {
    "MaxBytesPerArtefact": 10485760,
    "MaxBytesPerUser": 209715200
  },
  "Workers": {
    "QueuePollIntervalSeconds": 5,
    "MaxBatchSize": 5,
    "MaxConcurrency": 2,
    "MaxRetries": 3,
    "RetryBackoffSeconds": [10, 30, 90],
    "ProposalExpiryMinutes": 1440,
    "EnableAutoQueueProcessing": true
  },
  "Llm": {
    "EnableLiveProviders": false,
    "AllowLiveProvidersInDevelopment": false,
    "Provider": "Mock",
    "OpenAi": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-5.6-luna",
      "TimeoutSeconds": 30
    },
    "OpenAiCompatible": {
      "ApiKey": "",
      "BaseUrl": "",
      "Model": "",
      "TimeoutSeconds": 30,
      "MaxResponseBytes": 1048576,
      "MaxSseLineBytes": 65536,
      "MaxSseEventBytes": 131072,
      "ExtraHeaders": {}
    },
    "Ollama": {
      "BaseUrl": null,
      "Model": "llama3.2",
      "TimeoutSeconds": 120
    }
  },
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "BreakDurationSeconds": 60
  },
  "Observability": {
    "EnableOpenTelemetry": true,
    "ServiceName": "Taskdeck.Api",
    "OtlpEndpoint": "",
    "EnableConsoleExporter": false,
    "MetricExportIntervalSeconds": 30
  },
  "Sentry": {
    "Enabled": false,
    "Dsn": "",
    "Environment": "production",
    "TracesSampleRate": 0.1,
    "SendDefaultPii": false
  },
  "Telemetry": {
    "Enabled": false,
    "MaxBatchSize": 100
  },
  "Analytics": {
    "Enabled": false,
    "Provider": "",
    "ScriptUrl": "",
    "SiteId": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPerIp": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "HotPathPerUser": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "CaptureWritePerUser": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "SecurityHeaders": {
    "Enabled": true,
    "EnableContentSecurityPolicy": true,
    "EnableXFrameOptions": true,
    "EnableXContentTypeOptions": true,
    "EnableReferrerPolicy": true,
    "EnableHsts": true,
    "ExcludeSwaggerFromContentSecurityPolicy": true,
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": false,
    "HstsPreload": false,
    "ContentSecurityPolicy": "default-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self'; font-src 'self'; style-src 'self'; script-src 'self'",
    "XFrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer"
  },
  "SignalR": {
    "Redis": {
      "ConnectionString": ""
    }
  },
  "LlmToolCalling": {
    "Enabled": true,
    "MaxToolResultBytes": 8000
  },
  "GitHubOAuth": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "Connectors": {
    "EncryptionKey": ""
  },
  "AllowedHosts": "*",
  "Database": {
    "CommandTimeoutSeconds": 30,
    "Backup": {
      "Enabled": true,
      "RetainCount": 5
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=taskdeck.db"
  },
  "FirstRun": {
    "AutoOpenBrowser": false,
    "Port": 5000,
    "ResolveAppDataDbPath": true
  }
}
